<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CANVideoEmulator.Video</RootNamespace>
    <AssemblyName>CANVideoEmulator.Video</AssemblyName>
    <!-- MediaElement is a WPF control, so this project needs the WPF surface.
         The Core, which owns IVideoPlayer, deliberately does not. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CANVideoEmulator.Core\CANVideoEmulator.Core.csproj" />
  </ItemGroup>
</Project>
