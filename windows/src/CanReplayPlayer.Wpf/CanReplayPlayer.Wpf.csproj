<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CanReplayPlayer.Wpf</RootNamespace>
    <AssemblyName>CanReplayPlayer</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>CAN Vehicle Replay</AssemblyTitle>
    <!-- win-x64 only: the PEAK driver and PCAN-Basic are Windows-only, and the
         exhibition target is a 64-bit Windows 10/11 machine (requirement 14). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also embedded as a resource so the window can use it at runtime; the
         ApplicationIcon above only stamps the EXE. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CanReplayPlayer.Core\CanReplayPlayer.Core.csproj" />
    <ProjectReference Include="..\CanReplayPlayer.Scenarios\CanReplayPlayer.Scenarios.csproj" />
    <ProjectReference Include="..\CanReplayPlayer.Pcan\CanReplayPlayer.Pcan.csproj" />
    <ProjectReference Include="..\CanReplayPlayer.Video\CanReplayPlayer.Video.csproj" />
  </ItemGroup>
</Project>
