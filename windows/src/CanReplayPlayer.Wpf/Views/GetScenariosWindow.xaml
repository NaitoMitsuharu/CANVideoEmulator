<Window x:Class="CanReplayPlayer.Wpf.Views.GetScenariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get Scenarios"
        Icon="/Assets/app.ico"
        Width="820" Height="640"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="GET SCENARIOS" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       FontFamily="{StaticResource UiFont}" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,5,0,14"
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="{StaticResource UiFont}"
                       Text="Downloads recorded driving data from comma.ai's comma2k19 dataset. Only the two Toyota RAV4 chunks are offered — the other eight are a Honda Civic, which this build has no signal definitions for." />
        </StackPanel>

        <!-- Step 1: pick a chunk -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="STEP 1 — CHOOSE A CHUNK" Style="{StaticResource SectionHeading}" />
                <ListBox x:Name="ChunkList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnChunkSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" CornerRadius="6" Padding="12,10"
                                                Background="{StaticResource SurfaceRaised}"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush"
                                                        Value="{StaticResource AccentDim}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush"
                                                        Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="{StaticResource UiFont}" />
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMuted}"
                                               FontFamily="{StaticResource UiFont}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                           FontSize="14" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource TextSecondary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="DOWNLOAD TO" Style="{StaticResource Label}" Margin="0,10,0,0" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceRaised}" CornerRadius="5"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Padding="10,7">
                        <TextBlock x:Name="TargetPath" TextTrimming="CharacterEllipsis"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource UiFont}" />
                    </Border>
                    <Button Grid.Column="1" Content="Change…" Margin="8,0,0,0"
                            Style="{StaticResource ToolButton}" Padding="12,6"
                            Click="OnChangeFolderClick" />
                </Grid>
                <TextBlock x:Name="SpaceWarning" FontSize="11" Margin="0,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{StaticResource Warn}"
                           FontFamily="{StaticResource UiFont}" />
            </StackPanel>
        </Border>

        <!-- Step 2: progress and next steps -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="STEP 2 — DOWNLOAD"
                           Style="{StaticResource SectionHeading}" />
                <StackPanel DockPanel.Dock="Top">
                    <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1"
                                 Background="{StaticResource SurfaceRaised}"
                                 Foreground="{StaticResource Accent}" BorderThickness="0" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="ProgressText" FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource MonoFont}" />
                        <TextBlock x:Name="SpeedText" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="{StaticResource MonoFont}" />
                    </Grid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource MonoFont}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="#12171E" CornerRadius="6" Padding="12"
                Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource TextMuted}"
                       FontFamily="{StaticResource UiFont}"
                       Text="After the download, the raw data has to be converted into Scenario Packages by the Scenario Builder, which needs Python and FFmpeg. This window prints the exact commands when the download finishes. The player itself never needs either." />
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="OpenPageButton" Content="Open Dataset Page"
                    Style="{StaticResource ToolButton}" Click="OnOpenPageClick" />
            <Button x:Name="CancelButton" Content="Cancel Download" Margin="10,0,0,0"
                    Style="{StaticResource ToolButton}" IsEnabled="False"
                    Click="OnCancelClick" />
            <Button x:Name="DownloadButton" Content="Download" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="OnDownloadClick" />
            <Button x:Name="CloseButton" Content="Close" Margin="10,0,0,0"
                    Style="{StaticResource ToolButton}" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
