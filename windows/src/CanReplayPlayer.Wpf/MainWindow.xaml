<Window x:Class="CanReplayPlayer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CanReplayPlayer.Wpf.ViewModels"
        xmlns:conv="clr-namespace:CanReplayPlayer.Wpf.Converters"
        Title="CAN Vehicle Replay"
        Icon="Assets/app.ico"
        Background="{StaticResource Background}"
        MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:HealthToBrushConverter x:Key="HealthBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolVisible" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolVisible" />
        <conv:NullToVisibilityConverter x:Key="NullVisible" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="TextVisible" />
        <conv:LoopModeNameConverter x:Key="LoopName" />
        <conv:BitrateTextConverter x:Key="BitrateText" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Key="Right" Command="{Binding SkipForwardCommand}" />
        <KeyBinding Key="Left" Command="{Binding SkipBackwardCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NextCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PreviousCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- title / PCAN status -->
            <RowDefinition Height="Auto" />   <!-- driver banner -->
            <RowDefinition Height="*" />      <!-- video + side panel -->
            <RowDefinition Height="Auto" />   <!-- transport controls -->
            <RowDefinition Height="240" />    <!-- scenario browser -->
            <RowDefinition Height="Auto" />   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ===================== Title bar ===================== -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CAN VEHICLE REPLAY" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource UiFont}" />
                    <Border Background="{StaticResource SurfaceRaised}" CornerRadius="4"
                            Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="comma2k19 · Toyota RAV4" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="{StaticResource UiFont}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- PCAN status pill, always visible (requirement 20) -->
                    <Border Background="{StaticResource SurfaceRaised}" CornerRadius="16"
                            Padding="14,6" BorderThickness="1"
                            BorderBrush="{Binding PcanHealth, Converter={StaticResource HealthBrush}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{Binding PcanHealth, Converter={StaticResource HealthBrush}}" />
                            <TextBlock Text="PCAN-USB" Margin="9,0,7,0" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource UiFont}" />
                            <TextBlock Text="{Binding PcanStatusText}" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       FontFamily="{StaticResource UiFont}"
                                       Foreground="{Binding PcanHealth,
                                                    Converter={StaticResource HealthBrush}}" />
                            <TextBlock Text="{Binding ChannelText, StringFormat=' · {0}'}"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource UiFont}" />
                        </StackPanel>
                    </Border>

                    <Button Content="Refresh" Style="{StaticResource ToolButton}"
                            Margin="10,0,0,0" Command="{Binding RefreshPcanCommand}"
                            ToolTip="Re-detect PCAN devices without restarting (requirement 21)" />
                    <Button Content="Test Connection" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" Command="{Binding TestConnectionCommand}"
                            ToolTip="Initialise the channel and read its status. Sends no CAN frames." />
                    <Button Content="Diagnostics" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" Click="OnDiagnosticsClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Driver-missing banner (requirement 59) ============ -->
        <Border Grid.Row="1" Background="#3A2A12" BorderBrush="{StaticResource Warn}"
                BorderThickness="0,0,0,1" Padding="18,10"
                Visibility="{Binding DriverMissing, Converter={StaticResource BoolVisible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PCAN-USB Driver is not installed."
                               FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource Warn}"
                               FontFamily="{StaticResource UiFont}" />
                    <TextBlock Text="{Binding PcanStatusDetail}" FontSize="12" Margin="0,3,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource UiFont}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Open PEAK Driver Download Page"
                        Style="{StaticResource ToolButton}" VerticalAlignment="Center"
                        Click="OnOpenDriverPageClick" />
            </Grid>
        </Border>

        <!-- ===================== Video + side panel ===================== -->
        <Grid Grid.Row="2" Margin="18,14,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Video -->
            <Border Style="{StaticResource Card}" Padding="0" Background="Black"
                    ClipToBounds="True">
                <Grid>
                    <MediaElement x:Name="Video" Stretch="Uniform"
                                  LoadedBehavior="Manual" UnloadedBehavior="Manual" />
                    <TextBlock Text="Select a scenario to begin"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="15" Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource UiFont}"
                               Visibility="{Binding SelectedScenario,
                                            Converter={StaticResource NullVisible}}" />
                </Grid>
            </Border>

            <!-- Side panel -->
            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto"
                          Padding="0,0,12,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="VEHICLE" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding VehicleText}" Style="{StaticResource ValueLarge}"
                                       Margin="0,2,0,14" />

                            <TextBlock Text="SCENARIO" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding ScenarioTitleText}"
                                       Style="{StaticResource ValueLarge}" TextWrapping="Wrap"
                                       Margin="0,2,0,14" />

                            <TextBlock Text="CAN BUS" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding AvailableBuses}"
                                      SelectedItem="{Binding SelectedBus}"
                                      Margin="0,4,0,6"
                                      ToolTip="Only the selected bus is transmitted. Recorded buses are never merged.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='Bus {0}'}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding BusStatisticsText}" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource UiFont}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="CAN OUTPUT" Style="{StaticResource SectionHeading}" />
                            <CheckBox Content="Transmit to PCAN-USB"
                                      IsChecked="{Binding UseHardware}"
                                      ToolTip="Off = Demo Mode: video plays and the scheduler runs, but nothing reaches the bus." />
                            <TextBlock Text="{Binding PcanStatusDetail}" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,8,0,0"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource UiFont}" />

                            <TextBlock Text="CHANNEL" Style="{StaticResource Label}" Margin="0,12,0,0" />
                            <ComboBox ItemsSource="{Binding PcanChannels}"
                                      SelectedItem="{Binding SelectedPcanChannel}"
                                      Margin="0,4,0,0"
                                      Visibility="{Binding PcanChannels.Count,
                                                   Converter={StaticResource TextVisible}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="BITRATE" Style="{StaticResource Label}" Margin="0,12,0,0" />
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:MainViewModel.Bitrates}}"
                                      SelectedItem="{Binding Bitrate}" Margin="0,4,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource BitrateText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Border Background="#3A2A12" CornerRadius="5" Padding="9" Margin="0,10,0,0"
                                    Visibility="{Binding HasBitrateMismatch,
                                                 Converter={StaticResource BoolVisible}}">
                                <TextBlock Text="{Binding BitrateMismatchWarning}" TextWrapping="Wrap"
                                           FontSize="11" Foreground="{StaticResource Warn}"
                                           FontFamily="{StaticResource UiFont}" />
                            </Border>
                            <TextBlock Text="Scenario bit rate: unknown (not stated by comma2k19)"
                                       FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource UiFont}"
                                       Visibility="{Binding ScenarioBitrateUnknown,
                                                    Converter={StaticResource BoolVisible}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="TIMING" Style="{StaticResource SectionHeading}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="CAN Rate" Style="{StaticResource Label}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Mono}"
                                           Text="{Binding FrameRateText, StringFormat='{}{0} fps'}" />

                                <!-- Scheduled vs sent localises a shortfall to the PC
                                     before anyone starts checking CAN wiring. -->
                                <TextBlock Grid.Row="1" Text="Frames Scheduled"
                                           Style="{StaticResource Label}"
                                           Margin="0,6,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                           Style="{StaticResource Mono}"
                                           Text="{Binding FramesScheduledText}" />

                                <TextBlock Grid.Row="2" Text="Frames Sent" Style="{StaticResource Label}"
                                           Margin="0,6,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                                           Style="{StaticResource Mono}" Text="{Binding FramesSentText}" />

                                <TextBlock Grid.Row="3" Text="Send Errors" Style="{StaticResource Label}"
                                           Margin="0,6,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"
                                           Style="{StaticResource Mono}" Text="{Binding ErrorsText}" />

                                <TextBlock Grid.Row="4" Text="Windows Loss" Style="{StaticResource Label}"
                                           Margin="0,6,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"
                                           Style="{StaticResource Mono}" Text="{Binding LossText}" />

                                <TextBlock Grid.Row="5" Text="Jitter" Style="{StaticResource Label}"
                                           Margin="0,6,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0"
                                           Style="{StaticResource Mono}" Text="{Binding JitterText}" />
                            </Grid>
                            <TextBlock Text="{Binding JitterDetailText}" FontSize="10.5"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource MonoFont}"
                                       Visibility="{Binding HasJitterDetail,
                                                    Converter={StaticResource BoolVisible}}" />
                        </StackPanel>
                    </Border>

                    <!-- End-to-end bring-up: 1 / 5 / 30 / 60 s (phase 2 requirement 4) -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="END-TO-END TEST" Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="Transmits this scenario from 0 s for a fixed time, then reports what was scheduled and what was sent. Run the short tests first."
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource UiFont}" />
                            <ItemsControl ItemsSource="{Binding Source={x:Static vm:MainViewModel.BenchDurationsSeconds}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Content is an object, so StringFormat is
                                             ignored on it; the unit has to come from
                                             a TextBlock. -->
                                        <Button Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                                                Padding="6,7"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.RunBenchCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Text="{Binding StringFormat='{}{0} s'}"
                                                       FontFamily="{StaticResource UiFont}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Test running…" FontSize="11" Margin="0,8,0,0"
                                       Foreground="{StaticResource Accent}"
                                       FontFamily="{StaticResource UiFont}"
                                       Visibility="{Binding BenchRunning,
                                                    Converter={StaticResource BoolVisible}}" />
                            <Border Background="#3A1A1A" BorderBrush="{StaticResource Bad}"
                                    BorderThickness="1" CornerRadius="5" Padding="9"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding BenchFailed,
                                                 Converter={StaticResource BoolVisible}}">
                                <TextBlock Text="This run is not a pass — see the verdict below."
                                           FontSize="11" TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Bad}"
                                           FontFamily="{StaticResource UiFont}" />
                            </Border>
                            <Border Background="#12171E" CornerRadius="5" Padding="8" Margin="0,8,0,0"
                                    Visibility="{Binding BenchStatus,
                                                 Converter={StaticResource TextVisible}}">
                                <TextBlock Text="{Binding BenchStatus}" FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource MonoFont}" />
                            </Border>
                            <Button Content="Copy Test Report" Style="{StaticResource ToolButton}"
                                    Margin="0,8,0,0" Padding="10,6" HorizontalAlignment="Left"
                                    Click="OnCopyBenchReportClick"
                                    Visibility="{Binding BenchStatus,
                                                 Converter={StaticResource TextVisible}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="RECENT CAN" Style="{StaticResource SectionHeading}" />
                            <!-- Fixed row count, no scrolling: the stream replaces
                                 these faster than anyone can chase a scrollbar. -->
                            <DataGrid ItemsSource="{Binding RecentCan.Rows}"
                                      AutoGenerateColumns="False"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      IsHitTestVisible="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="60" />
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="38" />
                                    <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock FontSize="11" Margin="0,8,0,2"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource UiFont}"
                                       Text="No frames yet — press PLAY."
                                       Visibility="{Binding HasRecentCan,
                                                    Converter={StaticResource InverseBoolVisible}}" />
                            <TextBlock FontSize="10.5" Margin="0,6,0,0"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource UiFont}"
                                       Text="{Binding RecentCanCaption}"
                                       Visibility="{Binding HasRecentCan,
                                                    Converter={StaticResource BoolVisible}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===================== Transport controls ===================== -->
        <Border Grid.Row="3" Margin="18,14,18,0" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="⏮ Previous" Style="{StaticResource ToolButton}"
                                Command="{Binding PreviousCommand}" />
                        <Button Content="◀◀ 10s" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                Command="{Binding SkipBackwardCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Command="{Binding PlayPauseCommand}" MinWidth="120">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▶  PLAY" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Text" Value="❚❚  PAUSE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Content="■ Stop" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                Command="{Binding StopCommand}" />
                        <Button Content="10s ▶▶" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                Command="{Binding SkipForwardCommand}" />
                        <Button Content="Next ⏭" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                Command="{Binding NextCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PLAYLIST" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                                  MinWidth="170">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="LOOP" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox ItemsSource="{Binding Source={x:Static vm:MainViewModel.LoopModes}}"
                                  SelectedItem="{Binding LoopMode}" MinWidth="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource LoopName}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SeekSlider" Style="{StaticResource SeekBar}"
                            Value="{Binding Progress, Mode=OneWay}"
                            PreviewMouseLeftButtonUp="OnSeekBarReleased"
                            Thumb.DragCompleted="OnSeekDragCompleted" />
                    <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Mono}" FontSize="14">
                        <Run Text="{Binding PositionText, Mode=OneWay}" />
                        <Run Text=" / " Foreground="{StaticResource TextMuted}" />
                        <Run Text="{Binding DurationText, Mode=OneWay}"
                             Foreground="{StaticResource TextSecondary}" />
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== Scenario browser (requirement 34) ================ -->
        <Border Grid.Row="4" Margin="18,14,18,0" Style="{StaticResource Card}" Padding="14,12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SCENARIOS" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScenarioCount, StringFormat=' ({0})'}"
                                   Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ScenarioDirectory}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource UiFont}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="520" />
                        <Button Content="Get Scenarios…" Style="{StaticResource ToolButton}"
                                Padding="10,5" Click="OnGetScenariosClick"
                                ToolTip="Download recorded driving data from comma.ai's comma2k19 dataset." />
                        <Button Content="Change Folder…" Style="{StaticResource ToolButton}"
                                Margin="8,0,0,0" Padding="10,5" Click="OnChangeFolderClick" />
                        <Button Content="Reload" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                Padding="10,5" Command="{Binding ReloadScenariosCommand}" />
                    </StackPanel>
                </Grid>

                <ListBox ItemsSource="{Binding Scenarios}"
                         SelectedItem="{Binding SelectedScenario}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,12,0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="196" CornerRadius="7" Background="{StaticResource SurfaceRaised}"
                                    BorderThickness="2" Cursor="Hand" ToolTip="{Binding Tooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid Height="104">
                                        <Border Background="#0B0E13" CornerRadius="5,5,0,0" />
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        <TextBlock Text="no preview" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontFamily="{StaticResource UiFont}"
                                                   Visibility="{Binding Thumbnail,
                                                                Converter={StaticResource NullVisible}}" />
                                        <Border Background="#CC000000" CornerRadius="3" Padding="5,1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="6">
                                            <TextBlock Text="{Binding DurationText}" FontSize="11"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontFamily="{StaticResource MonoFont}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="10,8,10,10">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="13" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="{StaticResource UiFont}" />
                                        <TextBlock Text="{Binding Vehicle}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontFamily="{StaticResource UiFont}" />
                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#232C3A" CornerRadius="3"
                                                            Padding="5,1" Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   FontFamily="{StaticResource UiFont}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Border Grid.Row="5" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                Padding="18,8" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           FontFamily="{StaticResource UiFont}" />
                <TextBlock Grid.Column="1" Text="{Binding PlaybackStateText}" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource UiFont}" />
            </Grid>
        </Border>
    </Grid>
</Window>
