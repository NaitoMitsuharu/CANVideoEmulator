<Window x:Class="CANVideoEmulator.Wpf.Views.GetScenariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CANVideoEmulator.Wpf.Controls"
        Title="Get Scenarios"
        Icon="/Assets/app.ico"
        Width="960" Height="820" MinWidth="760" MinHeight="740"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="GET SCENARIOS" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       FontFamily="{StaticResource UiFont}" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,5,0,14"
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="{StaticResource UiFont}"
                       Text="Downloads recorded driving data from comma.ai's comma2k19 dataset. Select Toyota RAV4 (chunks 1–2) or Honda Civic (chunks 3–10). Downloads are converted automatically and added to the player. Existing files are reused." />
        </StackPanel>

        <!-- Step 1: pick a chunk -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <StackPanel>
                <TextBlock Text="STEP 1 — CHOOSE CHUNKS (click to select multiple)" Style="{StaticResource SectionHeading}" />
                <ListBox x:Name="ChunkList" MaxHeight="132" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                         SelectionMode="Multiple" SelectionChanged="OnChunkSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                         controls:ScrollTuning.PixelsPerNotch="36">
                    <!-- Minimal template: the default ListBox template paints its
                         background with SystemColors.ControlBrush (white) when
                         disabled, which flashes the whole panel white while a
                         conversion is running (ChunkList.IsEnabled = false). -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><controls:AdaptiveGridPanel MinimumItemWidth="380" MaximumColumns="2" Gap="6" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" CornerRadius="6" Padding="10,8"
                                                Background="{StaticResource SurfaceRaised}"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush"
                                                        Value="{StaticResource AccentDim}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush"
                                                        Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <CheckBox IsHitTestVisible="False" Focusable="False" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" Content="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="{StaticResource UiFont}" />
                                    <TextBlock Text="{Binding StatusText}" ToolTip="{Binding Location}" FontSize="11"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                           FontSize="12" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource TextSecondary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="DOWNLOAD TO" Style="{StaticResource Label}" Margin="0,10,0,0" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceRaised}" CornerRadius="5"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Padding="10,7">
                        <TextBlock x:Name="TargetPath" TextTrimming="CharacterEllipsis"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource UiFont}" />
                    </Border>
                    <Button x:Name="ChangeFolderButton" Grid.Column="1" Content="Change…" Margin="8,0,0,0"
                            Style="{StaticResource ToolButton}" Padding="12,6"
                            Click="OnChangeFolderClick" />
                </Grid>
                <TextBlock x:Name="SpaceWarning" FontSize="11" Margin="0,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{StaticResource Warn}"
                           FontFamily="{StaticResource UiFont}" />
                <TextBlock x:Name="SampleStatus" Margin="0,6,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}" />
                <TextBlock x:Name="SelectionSummary" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
        </Border>

        <!-- Step 2: progress and next steps -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="STEP 2 — DOWNLOAD"
                           Style="{StaticResource SectionHeading}" />
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock TextWrapping="Wrap" x:Name="DownloadStageText" Text="Existing files are skipped. Choose Download &amp; Convert to begin."
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,8" />
                    <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1"
                                 Background="{StaticResource SurfaceRaised}"
                                 Foreground="{StaticResource Accent}" BorderThickness="0" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="ProgressText" Text="Waiting to start" FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource MonoFont}" />
                        <TextBlock x:Name="SpeedText" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="{StaticResource MonoFont}" />
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="STEP 3 — CONVERT &amp; ADD TO PLAYER" Style="{StaticResource SectionHeading}" />
                    <TextBlock x:Name="ConvertStageText" Text="Runs automatically after Step 2. Python and FFmpeg must be installed."
                               TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    <ProgressBar x:Name="ConversionProgress" Height="8" Margin="0,8,0,6" IsIndeterminate="False"
                                 Minimum="0" Maximum="1" BorderThickness="0"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource SurfaceRaised}" />
                    <TextBlock x:Name="ConversionProgressText" Text="0% · Waiting to start" FontSize="11" Margin="0,0,0,8"
                               TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
                <ScrollViewer x:Name="ConversionLog" VerticalScrollBarVisibility="Auto" controls:ScrollTuning.PixelsPerNotch="36">
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MonoFont}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="ExampleButton" Content="Get 45 MB Sample" Margin="0,0,10,0" Style="{StaticResource PrimaryButton}" Click="OnExampleClick" />
            <Button x:Name="OpenPageButton" Content="Dataset Page"
                    Style="{StaticResource ToolButton}" Click="OnOpenPageClick" />
            <Button x:Name="CancelButton" Content="Cancel" Margin="10,0,0,0"
                    Style="{StaticResource ToolButton}" IsEnabled="False"
                    Click="OnCancelClick" />
            <Button x:Name="DownloadButton" Content="Download" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="OnDownloadClick" />
            <Button x:Name="CloseButton" Content="Close" Margin="10,0,0,0"
                    Style="{StaticResource ToolButton}" Click="OnCloseClick" />
        </WrapPanel>
    </Grid>
</Window>
