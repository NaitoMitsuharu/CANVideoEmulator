<Window x:Class="CANVideoEmulator.Wpf.Views.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CANVideoEmulator — Setup" Width="760" Height="560"
        Background="{StaticResource Background}" Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Viewbox Margin="24" Stretch="Uniform" StretchDirection="DownOnly">
        <Grid Width="704" Height="464">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
                <Grid>
                    <TextBlock Text="FIRST RUN SETUP" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource UiFont}" />
                    <TextBlock x:Name="StepCounter" HorizontalAlignment="Right" Style="{StaticResource Label}" />
                </Grid>
                <TextBlock Text="Set up video replay and CAN output. You can continue without hardware."
                           FontSize="12" Margin="0,5,0,14" Foreground="{StaticResource TextSecondary}" />
                <UniformGrid Columns="4" Margin="0,0,0,8">
                    <TextBlock x:Name="StepLabel0" Text="1  Scenario folder" />
                    <TextBlock x:Name="StepLabel1" Text="2  PCAN-USB" />
                    <TextBlock x:Name="StepLabel2" Text="3  CAN settings" />
                    <TextBlock x:Name="StepLabel3" Text="4  Ready" />
                </UniformGrid>
                <ProgressBar x:Name="StepProgress" Minimum="0" Maximum="4" Height="3"
                             Foreground="{StaticResource Accent}" Background="{StaticResource SurfaceRaised}" BorderThickness="0" />
            </StackPanel>

            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid x:Name="StepContent">
                    <Grid.RenderTransform><TranslateTransform x:Name="StepTranslation" /></Grid.RenderTransform>
                    <Border x:Name="FolderPage" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Choose your scenario folder" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Each scenario contains a video and recorded CAN data. You can add scenarios later from the player."
                                       TextWrapping="Wrap" FontSize="12" Margin="0,10,0,18" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="ScenarioPath" Style="{StaticResource Value}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="ScenarioResult" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <Button Content="Choose Folder…" Style="{StaticResource ToolButton}" HorizontalAlignment="Left"
                                    Margin="0,18,0,0" Click="OnChooseFolderClick" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="DevicePage" Visibility="Collapsed" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Check the CAN interface" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="The PEAK driver and PCAN-Basic API are needed for CAN output. Video-only replay works without them."
                                       TextWrapping="Wrap" FontSize="12" Margin="0,10,0,18" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="DriverResult" Style="{StaticResource Value}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DriverDetail" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="54"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Foreground="{StaticResource TextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Re-check" Style="{StaticResource ToolButton}" Click="OnRecheckClick" />
                                <Button x:Name="DriverPageButton" Content="PEAK Driver Download" Style="{StaticResource ToolButton}"
                                        Margin="10,0,0,0" Click="OnOpenDriverPageClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="SettingsPage" Visibility="Collapsed" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Set the CAN output" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <Grid Margin="0,20,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="CHANNEL" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="ChannelBox" Margin="0,6,0,0">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="BIT RATE" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="BitrateBox" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Match the output bit rate to the connected CAN network. The default playback rate is 500 kbit/s; the original recording bit rate is unknown."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="Transmit to PCAN-USB is on by default. Nothing is sent until PLAY. Turn it off for video-only playback."
                                       FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ReadyPage" Visibility="Collapsed" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Open CANVideoEmulator" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="ReadyText" Style="{StaticResource Value}" Margin="0,18,0,18" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReadySummary" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="Finish saves these settings and opens the player. Video playback and CAN transmission start only when you request them."
                                       FontSize="12" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Button Content="Exit" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Click="OnExitClick" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" MinWidth="90" Style="{StaticResource ToolButton}" Click="OnBackClick" />
                    <Button x:Name="NextButton" Content="Next" MinWidth="184" Style="{StaticResource PrimaryButton}"
                            Margin="12,0,0,0" IsDefault="True" Click="OnNextClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
