<Window x:Class="CANVideoEmulator.Wpf.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Diagnostics"
        Width="900" Height="720"
        Background="{StaticResource Background}"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SYSTEM DIAGNOSTICS" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       FontFamily="{StaticResource UiFont}" />
            <TextBlock Text="Everything support needs to tell a missing driver from a missing device."
                       FontSize="12" Margin="0,4,0,14"
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="{StaticResource UiFont}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <!-- No fixed RowHeight: paths and API messages wrap, and a fixed
                 height makes long rows overlap their neighbours. -->
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" Margin="4"
                      HeadersVisibility="Column" VerticalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="120" />
                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="230" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <TextBlock x:Name="CopiedNotice" Text="Copied to clipboard." VerticalAlignment="Center"
                       Margin="0,0,14,0" Visibility="Collapsed" FontSize="12"
                       Foreground="{StaticResource Good}"
                       FontFamily="{StaticResource UiFont}" />
            <Button Content="Open Log Folder" Style="{StaticResource ToolButton}"
                    Click="OnOpenLogsClick" />
            <Button Content="Copy Diagnostics" Style="{StaticResource PrimaryButton}"
                    Margin="10,0,0,0" Click="OnCopyClick" />
            <Button Content="Close" Style="{StaticResource ToolButton}" Margin="10,0,0,0"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
